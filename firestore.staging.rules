rules_version = '2';
// 測試版（qna-chinese-staging）專用：跟正式版相同，只差在主管理員也必須驗證信箱
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 身分判斷 ──────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function myEmail()  { return request.auth.token.email; }
    function verified() { return request.auth.token.email_verified == true; }

    // 主管理員：唯一能修改設定、題庫、刪除資料的人
    function isMaster() {
      return signedIn() && myEmail() == 'qnachinese@gmail.com' && verified();
    }
    // 管理員（含教授）：主管理員，或在 config/admins 的 adminEmails 名單內、且信箱已驗證
    function isAdmin() {
      return isMaster() || (signedIn() && verified()
        && myEmail() in get(/databases/$(database)/documents/config/admins).data.get('adminEmails', []));
    }
    // 這份資料屬於目前登入的人
    function owns(data) {
      return signedIn() && data.get('uid', '') == request.auth.uid;
    }
    // 舊帳號（還沒綁定）可由「信箱已驗證、且信箱相同」的本人認領
    function canClaim(data) {
      return signedIn() && verified()
        && data.get('uid', '') == '' && data.get('email', '') == myEmail();
    }

    // 註冊控制（後台設定）：config/regPublic 存「是否開放／要不要邀請碼／要不要審核」，config/regSecret 存邀請碼
    function regCfg() {
      return exists(/databases/$(database)/documents/config/regPublic)
        ? get(/databases/$(database)/documents/config/regPublic).data : {};
    }
    function regOK(d) {
      return regCfg().get('open', true) == true
        && (regCfg().get('inviteRequired', false) == false
            || d.get('invite', '') == get(/databases/$(database)/documents/config/regSecret).data.get('code', '__none__'))
        && (regCfg().get('approval', false) == false || d.get('status', '') == 'pending')
        && (!('status' in d) || d.status == 'pending');
    }

    // ── 學習者帳號 users/{名稱} ───────────────────────────────
    match /users/{name} {
      // get：查名稱是否已被使用（不存在才讀得到）、本人、可認領的本人、管理員
      allow get: if resource == null || isAdmin() || owns(resource.data) || canClaim(resource.data);
      // list（查詢）：管理員，或只查自己的（where uid == 自己）
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 建立：本人註冊（必須綁自己的 uid 與信箱、不得存密碼），或主管理員
      allow create: if isMaster()
        || (signedIn() && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == myEmail()
            && !('pw' in request.resource.data)
            && regOK(request.resource.data));
      // 更新：主管理員；本人（uid 不可改、不得存密碼）；本人認領舊帳號
      allow update: if isMaster()
        || (owns(resource.data) && request.resource.data.uid == request.auth.uid
            && !('pw' in request.resource.data)
            && request.resource.data.get('status', '') == resource.data.get('status', ''))
        || (canClaim(resource.data) && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == myEmail()
            && !('pw' in request.resource.data));
      allow delete: if isMaster();
    }

    // ── 考試紀錄 ──────────────────────────────────────────────
    match /config/examHistory/records/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isMaster() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isMaster()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid);
      allow delete: if isMaster() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── 訪客試做紀錄：任何人可新增，只有管理員能看 ──────────────
    match /config/guestHistory/records/{id} {
      allow create: if true;
      allow get, list: if isAdmin();
      allow update, delete: if isMaster();
    }

    // ── 舊帳號索引（升級用）：只能用「Email 的雜湊值」單筆查詢 ───────
    match /legacy/{h} {
      allow get: if true;
      allow list: if false;
      allow write: if isMaster();
    }

    // ── 管理員名單：管理員能讀，主管理員能改 ─────────────────────
    match /config/admins {
      allow read: if isAdmin();
      allow write: if isMaster();
    }

    // ── 舊版管理員密碼與驗證碼（已停用）──────────────────────────
    match /config/admin     { allow read, write: if isMaster(); }
    match /config/admin_otp { allow read, write: if isMaster(); }

    // ── 註冊設定：公開部分所有人可讀（註冊頁要知道要不要邀請碼），邀請碼只有主管理員看得到 ──
    match /config/regPublic { allow read: if true; allow write: if isMaster(); }
    match /config/regSecret { allow read, write: if isMaster(); }

    // ── 題庫：所有人可讀，主管理員可改 ───────────────────────────
    match /questionbank/{doc} {
      allow read: if true;
      allow write: if isMaster();
    }

    // ── 排行榜：每人一筆（只存遮名後的名字與成績摘要，不存信箱），所有人可看，只有本人能寫 ──
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && !('email' in request.resource.data);
      allow delete: if isMaster() || (signedIn() && uid == request.auth.uid);
    }

    // ── 留言板：所有人可看；登入者可留言／回覆（1～1000 字）；本人或主管理員可刪除 ──
    match /board/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      // 更新（v3.23）：本人只能改內容（text、editedAt）；登入者只能把「自己」加入或移出 likes
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is list
          && request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).union(
               resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet())) == [request.auth.uid].toSet())
      );
      allow delete: if isMaster() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── 留言操作紀錄（v3.23）：發文／回覆／編輯／刪除／按讚，登入者只能以自己的身分新增；只有管理員能看；不能修改 ──
    match /boardLog/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.action in ['post','reply','edit','delete','like','unlike','admin-delete'];
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isMaster();
    }

    // ── 訪客來訪統計：任何人可新增（每位訪客每月一筆，只能有 gid／month／first 三個欄位），只有管理員能看 ──
    match /guestVisits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['gid','month','first'])
        && request.resource.data.gid is string && request.resource.data.month is string;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isMaster();
    }

    // ── 網站瀏覽人數：total 與每天一筆；只能新增或 +1，任何人可讀，只有主管理員能刪 ──
    match /pageStats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views','visitors'])
        && request.resource.data.views == 1
        && request.resource.data.visitors is int && request.resource.data.visitors >= 0 && request.resource.data.visitors <= 1;
      allow update: if request.resource.data.keys().hasOnly(['views','visitors'])
        && request.resource.data.views == resource.data.get('views', 0) + 1
        && request.resource.data.visitors is int
        && request.resource.data.visitors >= resource.data.get('visitors', 0)
        && request.resource.data.visitors <= resource.data.get('visitors', 0) + 1;
      allow delete: if isMaster();
    }

    // 其他未列出的路徑一律拒絕
  }
}
